---
import "../styles/global.css";
import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';

import { useTranslations } from '../i18n/utils';const lang = Astro.currentLocale as 'tr' | 'en' || 'tr';
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{'Sinan Uygun'}</title>
        <ClientRouter />
    </head>
    <Sidebar />
    <body>
        <div class="fixed top-0 left-0 w-full z-[40] pointer-events-none">
            <div 
                class="w-full p-4 md:p-6 flex flex-col justify-center items-center border-b border-[var(--sau-fg-color)]/5 transition-all duration-500" 
                style="background-color: var(--sau-bg-color); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);"
            >
                <a href={lang === 'tr' ? '/' : '/en/'} class="pointer-events-auto no-underline text-center">
                    <h1 
                        class="text-2xl md:text-4xl font-black uppercase italic tracking-tighter transition-all duration-300 hover:scale-105"
                        style="color: var(--sau-fg-color);"
                    >
                        OXIDIAN
                    </h1>
                    <p class="text-[8px] md:text-[10px] font-bold uppercase tracking-[4px] opacity-40 leading-none mt-1" style={`color: var(--sau-fg-color);`}>
                        {lang === 'tr' ? 'BİLGİSAYAR MÜHENDİSİ' : 'COMPUTER ENGINEER'}
                    </p>
                </a>
            </div>
        </div>

        
        <slot />
    </body>
</html>

<style is:global>
    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100%;
        background-color: var(--sau-bg-color);
        overflow-x: hidden; 
        position: relative;
    }

    ::-webkit-scrollbar {
        width: 8px;
    }
    ::-webkit-scrollbar-track {
        background: var(--sau-bg-color);
    }
    ::-webkit-scrollbar-thumb {
        background: var(--sau-fg-color);
        border-radius: 0px;
    }
</style>