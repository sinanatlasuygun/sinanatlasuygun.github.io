---
import "../styles/global.css";
import Layout from '../layouts/Layout.astro';
import HomeCard from '../components/HomeCard.astro';
import ContentPageHome from "../content/ContentPageHome.astro";
import ContentProject from "../content/ContentProject.astro" ;
import ContentSkill from "../content/ConentSkill.astro";
import ContentAboutMe from "../content/ContentAboutMe.astro";
import ContentContact from "../content/ContentContact.astro";
import ContentCertification from "../content/ContentCertification.astro";

import { useTranslations } from '../i18n/utils';
const lang = Astro.currentLocale as 'tr' | 'en' || 'tr';
const t = useTranslations(lang);
---

<Layout title="Main Page">
  <main 
    class="min-h-screen w-full p-2 flex flex-col gap-2 pt-18 md:pt-24 bg-[#f8f4ec] dark:bg-[#121212]" 
  >
    <HomeCard bg="#6236a7" fg="#ffffff">
      <ContentPageHome/>
    </HomeCard>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-2 w-full">
      <HomeCard link="/aboutme" bg="#e62727" fg="#000000">
        <ContentAboutMe/>
      </HomeCard>

      <HomeCard link="/skill" bg="#77bef0" fg="#000000">
        <ContentSkill/>
      </HomeCard>
    </div>

    <HomeCard link="/project" bg="#ffcc00" fg="#000000">
      <ContentProject/>
    </HomeCard>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-2 w-full">
      <HomeCard link="/certification" bg="#500050" fg="#ffffff">
        <ContentCertification/>
      </HomeCard>

      <HomeCard link="/contact" bg="#2a3335" fg="#ffffff">
        <ContentContact/>
      </HomeCard>
    </div>

    <footer class="mt-auto pt-8 pb-4 pr-2 self-end w-full flex justify-end items-center">
      <p class="text-[10px] md:text-xs font-black uppercase italic tracking-widest opacity-60 text-[#2d204f] dark:text-[#f8f4ec]">
        {t('licence') || '© 2024 OXIDIAN — Tasarım & Kod'}
      </p>
    </footer>
  </main>
</Layout>