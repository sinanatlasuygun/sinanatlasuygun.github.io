---
import { useTranslations } from '../i18n/utils';
const lang = Astro.currentLocale as 'tr' | 'en' || 'tr';
const t = useTranslations(lang);

const { project } = Astro.props;


const isSoftware = project.type === 'Software';
const isArt = project.type === 'Art';
const typeIcon = isSoftware ? "code" : "palette"; 

const bg = "#111111"; 
const fg = "#ffffff"; 
const cardStyle = `background-color: ${bg}; color: ${fg}; border-color: ${fg}20;`;
---

<div 
  class="w-full rounded-[20px] p-4 flex flex-col justify-between border relative overflow-hidden min-h-[240px] shadow-2xl group hover:border-white/40 transition-all"
  style={cardStyle}
>
  <div class={`absolute top-3 left-3 w-7 h-7 flex items-center justify-center rounded-lg z-10 border border-white/10 backdrop-blur-md transition-transform group-hover:scale-110 ${isSoftware ? 'bg-blue-500/20 text-blue-400' : 'bg-purple-500/20 text-purple-400'}`}>
    {isSoftware ? (
        // Code İkonu (SVG)
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
    ) : (
        // Sanat / Palette İkonu (SVG)
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.92 0 1.76-.74 1.74-1.67a1.5 1.5 0 0 0-1.3-1.58C11.3 18.47 11 17.88 11 17c0-2.21 1.79-4 4-4h.78c.88 0 1.58.7 1.62 1.57.04.88.7 1.43 1.6 1.43H22c0-5.52-4.48-10-10-10Z"></path></svg>
    )}
  </div>

  <div class={`absolute top-3 right-3 px-2 py-1 rounded-md text-[9px] font-black uppercase tracking-widest z-10 ${project.complate ? 'bg-emerald-500 text-white' : 'bg-amber-500 text-black'}`}>
    {project.complate ? t('status.completed') : t('status.ongoing')}
  </div>

  <div class="w-full h-28 overflow-hidden rounded-[12px] mb-3 mt-4 italic">
    <img 
      src={project.image[lang]} 
      alt={project.title[lang]} 
      class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 scale-105 group-hover:scale-100"
    />
  </div>

  <div class="flex-1">
    <h3 class="text-lg font-black uppercase italic tracking-tighter mb-1 line-clamp-1">
      {project.title[lang]}
    </h3>
    <p class="text-[12px] font-medium opacity-70 leading-snug line-clamp-2 italic">
      {project.summary[lang]}
    </p>
  </div>
</div>