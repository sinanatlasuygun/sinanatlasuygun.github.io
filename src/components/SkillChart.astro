---
interface SkillDetail {
  name: string;
  percent: number;
  color: string;
}

interface Props {
  title: string;
  total: string;
  label: string;
  skills: SkillDetail[];
}

const { title, total, label, skills = [] } = Astro.props;
---

<div class="flex flex-col gap-4">
  <div class="flex items-end justify-between border-b border-black/10 pb-2">
    <h3 class="text-xl font-black uppercase italic tracking-tighter">{title}</h3>
    <div class="flex items-baseline gap-1">
      <span class="text-2xl font-black leading-none">{total}</span>
      <span class="text-[10px] uppercase font-bold opacity-60">{label}</span>
    </div>
  </div>

  <div class="flex flex-col gap-4">
    <div class="flex w-full h-4 bg-black/5 rounded-full overflow-hidden p-[1px]">
      {skills && skills.map((skill) => (
        <div 
          style={`width: ${skill.percent}%; background-color: ${skill.color};`}
          class="h-full first:rounded-l-full last:rounded-r-full transition-all hover:brightness-110 relative group/tooltip"
        >
          <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block z-50">
             <div class="bg-black text-white text-[9px] px-2 py-1 rounded shadow-xl whitespace-nowrap">
                {skill.name} %{skill.percent}
             </div>
          </div>
        </div>
      ))}
    </div>

    <div class="grid grid-cols-2 gap-x-4 gap-y-1">
      {skills && skills.map((skill) => (
        <div class="flex items-center justify-between border-b border-black/5 pb-0.5">
          <div class="flex items-center gap-1.5">
            <div class="w-1.5 h-1.5 rounded-full" style={`background-color: ${skill.color}`}></div>
            <span class="text-[10px] font-black uppercase italic tracking-tighter opacity-80">{skill.name}</span>
          </div>
          <span class="text-[9px] font-bold opacity-40 italic">%{skill.percent}</span>
        </div>
      ))}
    </div>
  </div>
</div>