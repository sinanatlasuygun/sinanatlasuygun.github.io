---
import "../styles/global.css";
const { title, link, bg, fg } = Astro.props; 

// Kart ve Buton Stilleri
const cardStyle = `background-color: ${bg}; color: ${fg}; border: 2px solid ${fg}20;`;
const buttonStyle = `background-color: ${fg}; color: ${bg};`;

import { useTranslations } from '../i18n/utils';
const lang = Astro.currentLocale as 'tr' | 'en' || 'tr';
const t = useTranslations(lang);
---

<div 
  class="w-full p-5 md:p-8 flex flex-col justify-between relative group transition-all duration-500 shadow-sm hover:shadow-xl overflow-hidden min-h-[220px]"
  style={`${cardStyle}; border-radius: 4px;`} 
>
  <div class="flex-1 z-10 w-full overflow-hidden"> 
      {title && (
        <div class="flex items-center gap-2 mb-3 md:mb-4">
          <div class="w-1 h-4 md:h-6 bg-current opacity-30 shrink-0"></div>
          
          <h2 
            class="font-black uppercase italic tracking-tighter leading-[0.9] break-words"
            style="font-size: clamp(1.2rem, 6vw, 2rem);"
          >
            {title}
          </h2>
        </div>
      )}
      
      <div class="font-bold text-[12px] md:text-base opacity-90 italic leading-tight pb-10 md:pb-0"> 
        <slot />
      </div>
  </div>

  {link && (
    <div class="absolute bottom-4 right-4 md:static md:mt-8 md:flex md:justify-end z-20">
      <a 
        href={link} 
        style={buttonStyle}
        class="inline-flex items-center gap-2 px-4 py-2 md:px-6 md:py-3 font-black uppercase italic tracking-[2px] text-[9px] md:text-[10px] no-underline transition-all hover:brightness-125"
      >
        <span>{t('button.more') || 'GO_TO()'}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4">
          <path d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
      </a>
    </div>
  )}
</div>