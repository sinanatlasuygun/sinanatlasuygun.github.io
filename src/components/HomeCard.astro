---
import "../styles/global.css";
const { title, link, bg, fg } = Astro.props; 

// Kart stili
const cardStyle = `background-color: ${bg}; color: ${fg}; border: 1px solid rgba(0,0,0,0.1);`;

// BUTON STİLİ: Tam tersi (Arka plan yazı rengi, yazı rengi arka plan)
const buttonStyle = `background-color: ${fg} !important; color: ${bg} !important;`;

import { useTranslations } from '../i18n/utils';
const lang = Astro.currentLocale as 'tr' | 'en' || 'tr';
const t = useTranslations(lang);
---

<div 
  class="w-full p-6 md:p-10 flex flex-col justify-between relative group transition-all duration-500 shadow-sm hover:shadow-2xl overflow-hidden min-h-[280px]"
  style={`${cardStyle} border-radius: 12px;`} 
>
  <div class="flex-1 z-10 w-full overflow-hidden"> 
      {title && (
        <div class="flex items-center gap-3 mb-6">
          <div class="w-1.5 h-8 bg-current opacity-30 shrink-0"></div>
          <h2 class="font-black uppercase italic tracking-tighter leading-none text-3xl md:text-5xl">
            {title}
          </h2>
        </div>
      )}
      
      <div class="font-bold text-sm md:text-lg opacity-90 italic leading-snug"> 
        <slot />
      </div>
  </div>

  {link && (
    <div class="mt-8 flex justify-end z-20">
      <a 
        href={link} 
        style={buttonStyle}
        class="inline-flex items-center gap-3 px-6 py-3 md:px-8 md:py-4 font-black uppercase italic tracking-[3px] text-[10px] md:text-xs no-underline transition-all hover:scale-105 active:scale-95 shadow-xl rounded-lg"
      >
        <span>{t('button.more') || 'DISCOVER_MORE'}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" style="stroke: currentColor;">
          <path d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
      </a>
    </div>
  )}
</div>