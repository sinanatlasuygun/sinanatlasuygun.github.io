---
import { useTranslations } from "../i18n/utils";
const lang = Astro.currentLocale as 'tr' | 'en' || 'tr';
const t = useTranslations(lang);
---
<main class="min-h-screen flex flex-col bg-transparent">
    
    <header class="w-full pt-32 pb-20 text-center border-b-4 border-black/10">
      <h1 class="text-[18vw] md:text-[11rem] font-black uppercase italic leading-[0.8] tracking-tighter text-black">
        {t('about.title.1')} <br class="md:hidden"/>
        <span class="text-white">{t('about.title.2')}</span>
      </h1>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 border-b-4 border-black/10">
      
      <div class="lg:col-span-7 p-8 md:p-20 lg:border-r-4 border-black/10 space-y-20">
        <section>
          <div class="inline-block bg-black px-5 py-2 rounded-full mb-8 shadow-xl">
            <span class="text-[#f8f4ec] text-[10px] font-black tracking-[4px] uppercase italic">PROFILE_DATA</span>
          </div>
          <p class="text-4xl md:text-6xl font-black italic leading-[1] tracking-tighter text-black">
            {t('about.description')}
          </p>
        </section>

        <section class="pt-16 border-t-2 border-black/5 flex flex-col md:flex-row justify-between items-center gap-10">
          <div class="space-y-2">
            <h3 class="text-4xl md:text-6xl font-black italic uppercase text-black leading-none">{t('about.education.uni')}</h3>
            <p class="text-xl font-bold text-black/40 italic">{t('about.education.degree')}</p>
          </div>
          <div class="bg-black p-8 rounded-[20px] -rotate-3 shadow-2xl">
             <span class="text-7xl font-black italic text-[#f8f4ec]">2.68</span>
          </div>
        </section>
      </div>

      <div class="lg:col-span-5 p-8 md:p-20 space-y-20">
        <section>
          <span class="text-black/50 text-[10px] font-black tracking-[5px] uppercase italic block mb-10">EXPERIENCE</span>
          <div class="space-y-12">
            <div class="group relative pl-8 border-l-4 border-black/10 hover:border-white transition-all">
              <p class="text-2xl font-black italic uppercase text-black">{t('about.experience.1')}</p>
              <p class="text-xs text-white/60 mt-2 tracking-widest uppercase italic font-bold">2024 / STAJYER</p>
            </div>
            <div class="group relative pl-8 border-l-4 border-black/10 hover:border-white transition-all">
              <p class="text-2xl font-black italic uppercase text-black">{t('about.experience.2')}</p>
              <p class="text-xs text-white/60 mt-2 tracking-widest uppercase italic font-bold">2024-2025 / STAJYER</p>
            </div>
          </div>
        </section>

        <section class="p-8 bg-black text-[#f8f4ec] rounded-[20px] shadow-2xl border-b-[10px] border-white/5">
          <span class="text-[9px] font-black tracking-[4px] uppercase block mb-4 italic opacity-50">BITIRME PROJESI</span>
          <h4 class="text-3xl md:text-5xl font-black uppercase leading-[0.85] mb-6 italic break-words">Steganography</h4>
          <p class="text-base font-bold leading-tight italic mb-8 opacity-80 border-l-2 border-white/20 pl-4">
             Steganografi: AES şifreleme kullanarak resim ve ses dosyalarına veri gizleme.
          </p>
          <div class="flex flex-wrap gap-2">
             <span class="px-3 py-1 bg-[#f8f4ec] text-black text-[9px] font-black uppercase italic rounded-md">PYTHON</span>
             <span class="px-3 py-1 bg-[#f8f4ec] text-black text-[9px] font-black uppercase italic rounded-md">CRYPTOGRAPHY</span>
          </div>
        </section>
      </div>
    </div>

   <footer class="w-full pt-32 pb-8 px-8 mt-auto flex flex-col gap-16">
      
      <div class="w-full text-center">
        <p class="text-[#f8f4ec] text-sm md:text-xl lg:text-2xl font-black uppercase italic tracking-[8px] md:tracking-[15px] leading-tight opacity-100 drop-shadow-sm">
          {t('about.motto')}
        </p>
      </div>

      <div class="w-full flex justify-end items-center border-t border-black/10 pt-6">
        <p 
          class="text-[10px] md:text-xs font-black uppercase italic tracking-widest opacity-60 transition-all hover:opacity-100 text-black"
        >
          {t('licence') || '© 2024 Sinan Uygun — Tasarım & Kod'}
        </p>
      </div>
    </footer>

  </main>