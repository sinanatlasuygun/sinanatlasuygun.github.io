---
import "../styles/global.css";
import { useTranslations } from '../i18n/utils';
const lang = Astro.currentLocale as 'tr' | 'en' || 'tr';
const t = useTranslations(lang);

import HomeMiniCard from '../components/HomeMiniCard.astro';
import { getProjectById, totalSoftware,totalArt} from "../app/data/project.data";


const project1 = getProjectById(1); 
const project2 = getProjectById(2); 
const art1 = getProjectById(3); 
const art2 = getProjectById(4); 

const goldBg = "#FFD700";
---

<div class="flex flex-col h-full py-4 px-2 select-none" style={`background-color: ${goldBg};`}>
  
  <div class="flex flex-col mb-10 border-b-4 border-black pb-4">
    <div class="flex justify-between items-end">
        <h2 class="text-6xl md:text-8xl font-black uppercase italic leading-[0.7] tracking-tighter text-black">
          {t('home.project.title.1') || 'PROJE'} <br/> <span class="opacity-30">{t('home.project.title.2') || 'LERİM'}</span>
        </h2>
        <div class="flex flex-col items-end">
            <span class="text-[10px] font-black uppercase tracking-[3px] text-black/60 italic">Collections</span>
            <span class="text-4xl font-black text-black leading-none italic">24/25</span>
        </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-12 gap-y-12">
    <div class="flex flex-col gap-6">
      <div class="flex items-end justify-between border-b-2 border-black/20 pb-2">
        <div class="flex items-center gap-3">
            <div class="w-3 h-3 bg-black rotate-45"></div>
            <h3 class="text-2xl font-black uppercase italic tracking-tighter text-black">{t('home.project.code') || 'YAZILIM'}</h3>
        </div>
        <div class="flex items-baseline gap-1 bg-black text-[#FFD700] px-2 py-0.5 rounded-sm">
          <span class="text-xl font-black leading-none">{totalSoftware}</span>
          <span class="text-[9px] uppercase font-bold">{t('home.project.code')}</span>
        </div>
      </div>
      
      <div class="grid grid-cols-2 gap-4">
        <HomeMiniCard project={project1}/>
        <HomeMiniCard project={project2}/>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <div class="flex items-end justify-between border-b-2 border-black/20 pb-2">
        <div class="flex items-center gap-3">
            <div class="w-3 h-3 border-2 border-black rounded-full"></div>
            <h3 class="text-2xl font-black uppercase italic tracking-tighter text-black">{t('home.project.art') || 'SANAT'}</h3>
        </div>
        <div class="flex items-baseline gap-1 bg-white text-black px-2 py-0.5 rounded-sm shadow-sm">
          <span class="text-xl font-black leading-none">{totalArt}</span>
          <span class="text-[9px] uppercase font-bold">{t('home.project.art')}</span>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <HomeMiniCard project={art1}/>
        <HomeMiniCard project={art2}/>
      </div>
    </div>
  </div>
</div>