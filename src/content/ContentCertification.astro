---
import { useTranslations } from '../i18n/utils';
const lang = Astro.currentLocale as 'tr' | 'en' || 'tr';
const t = useTranslations(lang);
import { getCertificateById } from "../app/data/certificate.data";


const project1 = getCertificateById(1); 
const project2 = getCertificateById(2); 
const art1 = getCertificateById(3); 
const art2 = getCertificateById(4); 

const certificates = [
  {
    provider: "HackerRank",
    name: "Python Basic",
    link: "/certificate/python_basic certificate.pdf",
    date: "2025"
  },
  {
    provider: "Udemy",
    name: "Logo Tasarımı + Illustrator",
    link: "/certificate/Logo Tasarımı Eğitimi + Temel Illustrator Eğitimi.pdf",
    date: "2020"
  },
  {
    provider: "BTK Akademi",
    name: "Dart Programlama Dili",
    link: "/certificate/Dart_Programlama_Dili_Sertifika.pdf",
    date: "2025"
  },
  {
    provider: "BTK Akademi",
    name: "Flutter ile Mobil Uygulama",
    link: "/certificate/Flutter_ile_Mobil_Uygulama_Geliştirme_Sertifika.pdf",
    date: "2025"
  }
];
---

<div class="flex flex-col h-full py-4 px-2" style="background-color: #500050;">
  <div class="flex items-center justify-between border-b border-white/20 pb-4 mb-6">
    <h2 class="text-3xl md:text-4xl font-black uppercase italic tracking-tighter text-white">
      {t('home.certification.title') || 'CERTIFICATES'}
    </h2>
    
    <div class="relative w-10 h-10 flex items-center justify-center group/icon">
      <div class="absolute inset-0 border border-white/20 rotate-45 group-hover/icon:rotate-90 transition-all duration-700"></div>
      <div class="absolute inset-1 border border-[#00f2ff]/30 -rotate-12 animate-pulse"></div>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00f2ff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="drop-shadow-[0_0_8px_#00f2ff] z-10">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-3 overflow-y-auto pr-2 custom-scrollbar">
    {certificates.map((cert) => (
      <a 
        href={cert.link} 
        target="_blank" 
        class="group relative flex flex-col p-4 border border-white/10 rounded-xl bg-white/5 hover:bg-white/10 transition-all duration-300 overflow-hidden"
      >
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000"></div>

        <div class="flex justify-between items-start z-10">
          <div class="flex gap-3 items-center">
            <div class="w-1.5 h-6 bg-[#00f2ff]/40 group-hover:bg-[#00f2ff] transition-all duration-300 rounded-full"></div>
            <div>
              <span class="text-[9px] font-black uppercase tracking-widest text-white/40 group-hover:text-white/80 transition-colors">
                {cert.provider} — {cert.date}
              </span>
              <h3 class="text-sm md:text-base font-bold text-white italic leading-tight mt-0.5">
                {cert.name}
              </h3>
            </div>
          </div>
          <div class="text-white/20 group-hover:text-[#00f2ff] group-hover:scale-110 transition-all">
             <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M10 14L21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
          </div>
        </div>
      </a>
    ))}
  </div>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.05); }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.2); border-radius: 10px; }
</style>