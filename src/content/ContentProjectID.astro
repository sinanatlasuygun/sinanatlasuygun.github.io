---
import { useTranslations } from "../i18n/utils";

const { project } = Astro.props;
const lang = Astro.currentLocale as 'tr' | 'en' || 'tr';
const t = useTranslations(lang);

const title = project.title[lang];
const description = project.description[lang];
const installation = project.installization[lang];
const usage = project.usage[lang];
---

<main class="min-h-screen p-4 md:p-12 bg-transparent relative z-10">
    
    <header class="max-w-7xl mx-auto pt-24 pb-16 border-b-2 border-black/20">
      <div class="flex flex-col md:flex-row justify-between items-end gap-10">
        <div class="space-y-6">
          <div class="flex items-center gap-4">
             <span class={`px-5 py-2 text-[10px] font-black uppercase italic rounded-full shadow-lg ${project.complate ? 'bg-black text-[#ffcc00]' : 'bg-[#e62727] text-white'}`}>
                {project.complate ? (lang === 'tr' ? '● Tamamlandı' : '● Completed') : (lang === 'tr' ? '○ Devam Ediyor' : '○ In Progress')}
             </span>
             <span class="text-black/40 text-[11px] font-black uppercase tracking-[6px] italic">/ System_Log_{project.id}</span>
          </div>
          <h1 class="text-6xl md:text-[10rem] font-black uppercase italic tracking-tighter leading-[0.8] text-black drop-shadow-sm">
            {title}
          </h1>
        </div>
        
        <div class="flex flex-wrap gap-2">
            {project.devlan.map((item: string) => (
                <span class="bg-black text-white px-5 py-2 text-[10px] font-black italic uppercase tracking-widest rounded-lg">
                    {item}
                </span>
            ))}
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 py-24">
      
      <div class="lg:col-span-8 space-y-12">
        
        <article class="sau-project-box text-white group">
            <h2 class="text-[#ffcc00] text-[10px] font-black uppercase tracking-[12px] mb-10 italic opacity-50">01 // Executive_Summary</h2>
            <p class="text-2xl md:text-4xl font-black leading-[1.1] italic tracking-tight text-white/90 group-hover:text-white transition-colors">
                "{description}"
            </p>
        </article>

        <article class="sau-project-box text-white">
            <h2 class="text-[#77bef0] text-[10px] font-black uppercase tracking-[12px] mb-10 italic opacity-50">02 // Deployment_Script</h2>
            <div class="sau-project-code-terminal">
                <div class="flex gap-2 mb-8 opacity-30">
                    <div class="w-2.5 h-2.5 rounded-full bg-[#ffcc00]"></div>
                    <div class="w-2.5 h-2.5 rounded-full bg-white/20"></div>
                    <div class="w-2.5 h-2.5 rounded-full bg-white/20"></div>
                </div>
                <code class="text-[#ffcc00]/90 block whitespace-pre-wrap leading-relaxed font-mono">
                  $ {installation}
                </code>
            </div>
        </article>

        <article class="sau-project-box text-white border-l-8 border-[#ffcc00]">
            <h2 class="text-[#e62727] text-[10px] font-black uppercase tracking-[12px] mb-10 italic opacity-50">03 // Operation_Manual</h2>
            <div class="text-xl md:text-2xl font-black italic text-white/70 leading-relaxed">
                {usage}
            </div>
        </article>
      </div>

      <aside class="lg:col-span-4">
        <div class="sticky top-32 space-y-8">
            <div class="rounded-[20px] overflow-hidden border-4 border-black shadow-2xl group">
                <img src={project.image[lang]} alt={title} class="w-full h-auto grayscale group-hover:grayscale-0 transition-all duration-1000 group-hover:scale-110" />
            </div>

            <div class="flex flex-col gap-4">
                <a href={project.link[lang]} target="_blank" class="flex items-center justify-between w-full bg-black text-[#ffcc00] p-7 text-xs font-black uppercase tracking-[5px] italic rounded-[15px] hover:bg-[#e62727] hover:text-white transition-all shadow-xl">
                    Access Source <span class="text-2xl">↗</span>
                </a>
                <button onclick="history.back()" class="flex items-center justify-between w-full border-2 border-black p-7 text-xs font-black uppercase tracking-[5px] italic rounded-[15px] hover:bg-black hover:text-white transition-all">
                    Back to Lab <span>←</span>
                </button>
            </div>

            <div class="p-8 bg-black/5 rounded-[20px] border border-black/10">
                <span class="text-[9px] font-black uppercase tracking-widest opacity-40 block mb-2">Project_Checksum</span>
                <code class="text-[10px] font-bold text-black opacity-60">SHA-256: SAU_PRJ_{project.id}_VER_2.0</code>
            </div>
        </div>
      </aside>

    </div>

    <footer class="max-w-7xl mx-auto py-20 border-t border-black/10 flex justify-center">
       <p class="text-black/20 text-[10px] font-black uppercase tracking-[30px] italic">Final_Transmission</p>
    </footer>
</main>