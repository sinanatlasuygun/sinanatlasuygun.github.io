---
import { CERTIFICATE } from "../app/data/certificate.data";
import { useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale as 'tr' | 'en' || 'tr';
const t = useTranslations(lang);
---

<main class="min-h-screen p-4 flex flex-col bg-transparent">
    
    <header class="w-full pt-28 pb-20 border-b-2 border-white/10 relative overflow-hidden px-6">
      <div class="flex flex-col md:flex-row justify-between items-end gap-8 relative z-10">
        <div>
          <span class="text-white/60 text-[10px] font-black tracking-[12px] uppercase italic block mb-4">
            Academic & Professional
          </span>
          <h1 class="text-7xl md:text-[10rem] font-black uppercase italic leading-[0.8] tracking-tighter text-white">
            CERTIFI<span class="text-[#f8f4ec] opacity-40">CATES</span>
          </h1>
        </div>
        
        <div class="flex flex-col items-end">
            <div class="w-24 h-24 border-2 border-white/20 rounded-full flex items-center justify-center -rotate-12 mb-4">
                <span class="text-white font-black text-[9px] text-center uppercase tracking-tighter italic">Official<br/>Credentials</span>
            </div>
            <p class="text-white/40 font-black tracking-[4px] uppercase italic text-[10px]">Size: {CERTIFICATE.length}</p>
        </div>
      </div>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
      {CERTIFICATE.map((cert) => (
        <div class="sau-cert-card group">
          <div>
            <div class="flex justify-between items-start mb-8">
                <span class="text-[#f8f4ec] font-black italic text-lg opacity-40">
                  /{cert.id < 10 ? `0${cert.id}` : cert.id}
                </span>
                <div class="text-[#f8f4ec] opacity-20 group-hover:opacity-100 transition-all">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 15l-2 5l9-11h-7l2-5l-9 11h7z"/>
                  </svg>
                </div>
            </div>
            
            <h3 class="text-2xl md:text-3xl font-black uppercase italic leading-[0.9] mb-6 tracking-tighter text-white group-hover:text-[#f8f4ec] transition-colors">
              {cert.name}
            </h3>
            
            <div class="flex items-center gap-3 mb-10 pb-6 border-b border-white/10">
                <div class="w-1.5 h-6 bg-[#f8f4ec] opacity-50 rounded-full"></div>
                <p class="text-[11px] font-black uppercase tracking-widest text-white/60 italic">{cert.institution}</p>
            </div>
          </div>

          <a href={cert.path.replace('/public', '')} target="_blank" class="sau-cert-btn">
            View Document
            <span class="text-xl">→</span>
          </a>
        </div>
      ))}
    </div>

    <footer class="mt-auto py-20 text-center">
        <p class="text-white/20 text-[10px] font-black uppercase tracking-[20px] italic">
          Continuous Archive
        </p>
    </footer>
</main>